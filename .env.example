# Vitaminfun — cấu hình dùng chung cho api/ và web/
# Copy thành .env rồi sửa. KHÔNG commit .env.

# --- Chung ---
APP_ENV=development
APP_DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vitaminfun
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5433/vitaminfun

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Bao lau quet mot lan de chot cac luot choi da het gio (giay). 0 = tat.
RUN_SWEEP_SECONDS=60
API_RELOAD=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Cho phep nguoi la TU mo tai khoan o man dang nhap. false = giau nut Dang ky
# ben web VA endpoint POST /auth/signup tu choi. Mot bien cho ca hai phia.
# Doi bien nay thi KHOI DONG LAI ca API lan web (khong can build lai web).
ALLOW_SELF_SIGNUP=true

# Tối thiểu 32 ký tự. Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-key-change-me-32chars

# --- Web ---
# Ten bien PORT do Next quy dinh. Nap boi web/scripts/with-root-env.mjs TRUOC
# khi Next khoi dong -- xem docs/DEPLOY.md 0.4. Doi cong nay thi sua ca CORS_ORIGINS.
PORT=3000
# URL trình duyệt gọi tới API. Để trống khi web tự proxy qua route handler.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL server-side của web gọi tới API (trong Docker sẽ khác NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=http://localhost:8000/api/v1

# --- Lưu trữ media (dùng từ Bước 2) ---
# PHẢI nằm ngoài thư mục mã nguồn, không thì git clean là mất hết ảnh đã upload.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../vitaminfun-storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

# --- Doc chu thanh tieng ---------------------------------------------------
# Khoa API ElevenLabs. De trong = chua cau hinh, va khi do `POST /voices/sync`
# tu choi thang thay vi goi ra ngoai roi nhan 401.
# Bao nhieu cau doc CUNG LUC khi sinh ca me. Nha cung cap chan so request dong
# thoi theo hang tai khoan: hang thap chi vai luong, hang cao toi muoi lam.
# Nam la muc di duoc o gan het cac hang. Dat qua tay khong vo me - gap 429 thi
# lui lai roi thu tiep, cai gia chi la cham.
ELEVENLABS_CONCURRENCY=5
ELEVENLABS_API_KEY=

# --- Bao cao cho giao vien ---
# Mui gio dung de cat "hom nay / 7 ngay" tren man bao cao. Doi thi khoi dong lai API.
REPORTS_TIMEZONE=Asia/Bangkok

# --- Realtime (bắt buộc từ Bước 7) ---
CACHE_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Tài khoản mẫu cho seed ---
SEED_ADMIN_EMAIL=admin@vitaminfun.local
SEED_TEACHER_EMAIL=teacher@vitaminfun.local
SEED_STUDENT_EMAIL=student@vitaminfun.local
SEED_DEFAULT_PASSWORD=vitaminfun123
