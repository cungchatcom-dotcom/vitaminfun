# Vitaminfun — cấu hình dùng chung cho api/ và web/
# Copy thành .env rồi sửa. KHÔNG commit .env.

# --- Chung ---
APP_ENV=development
APP_DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vitaminfun
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5433/vitaminfun

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Tối thiểu 32 ký tự. Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-key-change-me-32chars

# --- Web ---
# Ten bien PORT do Next quy dinh. Nap boi web/scripts/with-root-env.mjs TRUOC
# khi Next khoi dong -- xem docs/DEPLOY.md 0.4. Doi cong nay thi sua ca CORS_ORIGINS.
PORT=3000
# URL trình duyệt gọi tới API. Để trống khi web tự proxy qua route handler.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL server-side của web gọi tới API (trong Docker sẽ khác NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=http://localhost:8000/api/v1

# --- Lưu trữ media (dùng từ Bước 2) ---
# PHẢI nằm ngoài thư mục mã nguồn, không thì git clean là mất hết ảnh đã upload.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../vitaminfun-storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

# --- Realtime (bắt buộc từ Bước 7) ---
CACHE_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Tài khoản mẫu cho seed ---
SEED_ADMIN_EMAIL=admin@vitaminfun.local
SEED_TEACHER_EMAIL=teacher@vitaminfun.local
SEED_STUDENT_EMAIL=student@vitaminfun.local
SEED_DEFAULT_PASSWORD=vitaminfun123
